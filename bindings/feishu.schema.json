{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-core.dev/schemas/bindings/feishu.schema.json",
  "title": "Feishu chat_id to agent_id bindings",
  "description": "Maps Feishu group chat_id to an agent_id. A chat that is not listed falls back to the kernel default agent. The kernel validates this file fail-closed: an invalid file rejects the group message with a clear error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bindings"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chat_id", "agent_id"],
        "properties": {
          "chat_id": {
            "type": "string",
            "minLength": 1
          },
          "agent_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    }
  }
}
